# Copier ce fichier en "server/.env" (jamais versionné) puis remplir.

# Base PostgreSQL utilisée par Prisma (obligatoire).
# Supabase : Dashboard > bouton "Connect" > "Session pooler" > URI (port 5432), remplacer [YOUR-PASSWORD].
# PostgreSQL local : postgresql://postgres:motdepasse@localhost:5432/hackfest
DATABASE_URL=

# Base des tests automatiques (npm test) : la MÊME adresse que DATABASE_URL, avec "?schema=test" à la fin.
# Les tests vident leurs tables : un schéma séparé protège les vraies données (schéma "public").
DATABASE_URL_TEST=

# Secret qui signe les jetons de connexion : mettre une longue chaîne aléatoire.
JWT_SECRET=

# (Facultatif) crée ou promeut un compte administrateur lors du seed (npm run db:seed).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Adresse(s) du site autorisée(s) par CORS, séparées par des virgules.
CLIENT_URL=http://localhost:5173

# (Facultatif) Nombre max de requêtes par IP en 15 minutes (300 par défaut).
LIMITE_REQUETES=
# (Facultatif) Mettre 1 si l'API est derrière un hébergeur / proxy (Render, Railway…).
TRUST_PROXY=

# ---------- Envoi des e-mails (code de vérification à l'inscription) ----------
# Gmail : compte Google > Sécurité > activer la « Validation en 2 étapes »,
# puis « Mots de passe des applications » > créer « HackFest » > copier le mot de passe de 16 lettres.
# (Jamais le mot de passe habituel du compte Gmail.)
# Sans SMTP_USER / SMTP_PASS en développement, le code s'affiche dans le terminal de l'API.
SMTP_USER=
SMTP_PASS=
# Facultatif (Gmail par défaut) :
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Facultatif : nom affiché comme expéditeur (sinon « HackFest <SMTP_USER> »)
EMAIL_EXPEDITEUR=
