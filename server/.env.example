# Copier ce fichier en "server/.env" (jamais versionné) puis remplir.

# Base Supabase : Dashboard > bouton "Connect" > "Session pooler" > URI.
# Remplacer [YOUR-PASSWORD] par le mot de passe de la base.
# Sans cette ligne, l'API utilise une base PostgreSQL locale (server/data/pglite).
DATABASE_URL=

# Secret qui signe les jetons de connexion : mettre une longue chaîne aléatoire.
JWT_SECRET=
