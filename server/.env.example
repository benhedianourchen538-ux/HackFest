# Copier ce fichier en "server/.env" (jamais versionné) puis remplir.

# Base PostgreSQL utilisée par Prisma (obligatoire).
# Supabase : Dashboard > bouton "Connect" > "Session pooler" > URI (port 5432), remplacer [YOUR-PASSWORD].
# PostgreSQL local : postgresql://postgres:motdepasse@localhost:5432/hackfest
DATABASE_URL=

# Secret qui signe les jetons de connexion : mettre une longue chaîne aléatoire.
JWT_SECRET=

# (Facultatif) crée ou promeut un compte administrateur lors du seed (npm run db:seed).
ADMIN_EMAIL=
ADMIN_PASSWORD=
